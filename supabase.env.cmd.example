@echo off
rem COPIA este fichero como supabase.env.cmd (ese nombre esta en .gitignore: NO se sube a git) y rellena tus datos.
rem Los encuentras en Supabase > Project Settings > Database > Connection string (modo "Transaction pooler", puerto 6543).
set SPRING_DATASOURCE_URL=jdbc:postgresql://HOST_DEL_POOLER:6543/postgres
set SPRING_DATASOURCE_USERNAME=postgres.XXXXXXXXXXXXXXXXXXXX
set SPRING_DATASOURCE_PASSWORD=TU_CONTRASENA_NUEVA
rem Clave para firmar los tokens de sesion: una frase larga y aleatoria (minimo 32 caracteres)
set TIMEWARP_JWT_SECRET=CAMBIA-ESTO-por-una-frase-larga-y-aleatoria-de-mas-de-32-caracteres
