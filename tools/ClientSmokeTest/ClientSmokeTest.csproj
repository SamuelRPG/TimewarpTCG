<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prueba de consola (opcional, NO es parte de Unity): compila los MISMOS scripts de red y modelo que usa Unity
       y juega partidas completas contra tu backend en marcha. Uso: dotnet run, seguido de los argumentos: host mazo partidas (ver LEEME) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../TimewarpTCG.Unity/Assets/Timewarp/Scripts/Net/*.cs" />
    <Compile Include="../../TimewarpTCG.Unity/Assets/Timewarp/Scripts/Model/*.cs" />
  </ItemGroup>
</Project>
